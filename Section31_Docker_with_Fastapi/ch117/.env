# ==============================
# MySQL Docker Configuration
# ==============================

# This value is used by the MySQL Docker container when 
# the MySQL database is initialized.
MYSQL_ROOT_PASSWORD=root
# Name of the database that MySQL will create automatically 
# when the container is initialized.
MYSQL_DATABASE=fastdb
# MySQL user for our application
MYSQL_USER=raj
# Password for the application user
MYSQL_PASSWORD=raj123


# ==============================
# FastAPI Database Configuration
# ==============================

# Database name used by FastAPI
# This must match: MYSQL_DATABASE=fastdb
DB_NAME=fastdb
# Database user used by FastAPI
# This must match: MYSQL_USER=raj
DB_USER=raj
# Database password used by FastAPI
# This must match: MYSQL_PASSWORD=raj123
DB_PASS=raj123
# Default MySQL port
DB_PORT=3306
# MySQL service name from docker-compose.yml
# Must match the service name exactly

# Example docker-compose.yml: 
# services: 
# mysql_db: 
# image: mysql:8 
# Therefore, FastAPI uses: 
# DB_HOST=mysql_db 
# NOT: 
# DB_HOST=localhost
DB_HOST=mysql_db
