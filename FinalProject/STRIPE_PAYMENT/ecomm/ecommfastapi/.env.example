# Database Configuration (MySQL / XAMPP)
DB_USER=your_mysql_user
DB_PASS=your_mysql_password
DB_NAME=ecommdb
DB_PORT=3306
DB_HOST=localhost

# Security & JWT Tokens
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TIME_MIN=15
JWT_REFRESH_TOKEN_TIME_DAY=7

# Email Verification & Password Reset
EMAIL_VERIFICATION_TOKEN_TIME_HOUR=1
EMAIL_PASSWORD_RESET_TOKEN_TIME_HOUR=2

# Frontend Client URL
FRONTEND_URL=http://localhost:3000

# Stripe Configuration
# In Account-Free local mock mode:
# - STRIPE_SECRET_KEY can be any dummy key (e.g. sk_test_mock_123)
# - STRIPE_PUBLISHABLE_KEY can be any dummy key (e.g. pk_test_mock_123)
# - STRIPE_WEBHOOK_SECRET is your locally chosen secret for HMAC signatures
# - STRIPE_API_BASE points to stripe-mock server (http://localhost:12111)
# In Real Stripe Sandbox mode:
# - STRIPE_SECRET_KEY=sk_test_...
# - STRIPE_PUBLISHABLE_KEY=pk_test_...
# - STRIPE_WEBHOOK_SECRET=whsec_...
# - STRIPE_API_BASE=https://api.stripe.com (or leave empty)
STRIPE_SECRET_KEY=sk_test_123
STRIPE_PUBLISHABLE_KEY=pk_test_123
STRIPE_WEBHOOK_SECRET=whsec_test_secret_for_local_mock_123
STRIPE_API_BASE=http://localhost:12111
STRIPE_CURRENCY=usd
